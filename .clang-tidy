# Google C++ style (names, google-* rules) plus the bug and readability checks.
# Needs build/compile_commands.json (CMAKE_EXPORT_COMPILE_COMMANDS in CMakeLists.txt).
# Run:  clang-tidy -p build src/main.cpp
#
# Disabled, because they don't suit an emulator:
#   bugprone-easily-swappable-parameters         every Add(uint8_t a, uint8_t b)
#   misc-include-cleaner                         noisy in a header-only library
#   readability-magic-numbers                    opcode masks and register addresses are the spec
#   readability-identifier-length                rd, rr, k, q are the datasheet's names
#   readability-function-cognitive-complexity    the decoder and execute switch are long by nature
#   readability-convert-member-functions-to-static, readability-make-member-function-const
#                                                too many false positives
# To switch a check off, add "-name" to the list below. Don't comment lines out inside "Checks: >":
# YAML keeps them as part of the text.
---
Checks: >
  -*,
  bugprone-*,
  google-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-convert-member-functions-to-static,
  -readability-make-member-function-const
HeaderFilterRegex: '.*/(include|src|tests)/.*'
CheckOptions:
  # Types: MyClass, MyEnum, MyAlias
  - { key: readability-identifier-naming.ClassCase,              value: CamelCase }
  - { key: readability-identifier-naming.StructCase,             value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,               value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase,          value: CamelCase }
  - { key: readability-identifier-naming.TypedefCase,            value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase,  value: CamelCase }
  - { key: readability-identifier-naming.ValueTemplateParameterCase, value: CamelCase }
  # Functions: ReadRegister(); accessors like sreg() are allowed by the guide but flagged here
  - { key: readability-identifier-naming.FunctionCase,           value: CamelCase }
  - { key: readability-identifier-naming.MethodCase,             value: CamelCase }
  # Variables: snake_case; class data members end in _, struct members don't
  - { key: readability-identifier-naming.VariableCase,           value: lower_case }
  - { key: readability-identifier-naming.ParameterCase,          value: lower_case }
  - { key: readability-identifier-naming.LocalConstantCase,      value: lower_case }
  - { key: readability-identifier-naming.MemberCase,             value: lower_case }
  - { key: readability-identifier-naming.ClassMemberCase,        value: lower_case }
  - { key: readability-identifier-naming.ClassMemberSuffix,      value: _ }
  - { key: readability-identifier-naming.PrivateMemberSuffix,    value: _ }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,  value: _ }
  # Constants with static storage: kMaxCycles
  - { key: readability-identifier-naming.ConstexprVariableCase,  value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix, value: k }
  - { key: readability-identifier-naming.GlobalConstantCase,     value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix,   value: k }
  - { key: readability-identifier-naming.StaticConstantCase,     value: CamelCase }
  - { key: readability-identifier-naming.StaticConstantPrefix,   value: k }
  - { key: readability-identifier-naming.MemberConstantCase,     value: CamelCase }
  - { key: readability-identifier-naming.MemberConstantPrefix,   value: k }
  - { key: readability-identifier-naming.EnumConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantPrefix,     value: k }
  # Namespaces and macros
  - { key: readability-identifier-naming.NamespaceCase,          value: lower_case }
  - { key: readability-identifier-naming.MacroDefinitionCase,    value: UPPER_CASE }
  # if (ptr) and if (count) are fine
  - { key: readability-implicit-bool-conversion.AllowIntegerConditions, value: 1 }
  - { key: readability-implicit-bool-conversion.AllowPointerConditions, value: 1 }
